[app]
title = Jewellery ERP
package.name = jewelleryerp
package.domain = com.pyarelal
source.dir = .
source.include_exts = py,png,jpg,kv,atlas,db
version = 1.0
requirements = python3,kivy==2.3.0,fpdf2
orientation = portrait
fullscreen = 0
